# App image for the BOINC app "gnina" (ghcr.io/<owner>/boinc-app-gnina:<gnina version>).
# Built in CI, pulled by the volunteers' clients via apps/gnina/files/Dockerfile.
#
# gnina's release binary links CUDA 12 and cuDNN 9 dynamically. The runtime libraries are
# taken from NVIDIA's PyPI wheels (smaller than the nvidia/cuda images). The driver itself
# (libcuda) is injected on the host by the NVIDIA container toolkit (--gpus all).
# The versions below were tested with gnina 1.3.3 (gnina --version, CPU docking).
ARG BASE=ghcr.io/mblenn/boinc-app-base:trixie

FROM docker.io/library/python:3.12-slim AS cudalibs
RUN pip download --no-deps --only-binary=:all: -d /whl \
        nvidia-cudnn-cu12==9.5.0.50 \
        nvidia-cublas-cu12==12.6.4.1 \
        nvidia-cuda-runtime-cu12==12.9.79 \
        nvidia-cufft-cu12==11.4.1.4 \
        nvidia-cusparse-cu12==12.5.10.65 \
        nvidia-cusolver-cu12==11.7.1.2 \
        nvidia-nvjitlink-cu12==12.9.86 \
    && mkdir -p /x /cuda \
    && for w in /whl/*.whl; do python -m zipfile -e "$w" /x; done \
    && find /x -path '*/lib/*' -name '*.so*' -exec cp -a {} /cuda/ \; \
    && rm -f /cuda/libnvblas* /cuda/libcufftw* /cuda/libcusolverMg*

FROM ${BASE}
ARG GNINA_VERSION=1.3.3
ADD https://github.com/gnina/gnina/releases/download/v${GNINA_VERSION}/gnina.cuda12.8.static /usr/local/bin/gnina
COPY --from=cudalibs /cuda /usr/local/lib/gnina-cuda
ENV LD_LIBRARY_PATH=/usr/local/lib/gnina-cuda
RUN chmod 755 /usr/local/bin/gnina \
    && echo /usr/local/lib/gnina-cuda > /etc/ld.so.conf.d/gnina-cuda.conf && ldconfig \
    && gnina --version
LABEL org.opencontainers.image.description="gnina ${GNINA_VERSION} with CUDA/cuDNN runtime for boinc-stack"
