# BOINC app "gnina": protein-ligand docking with CNN scoring (gnina), test workload.
APP_NAME=gnina
APP_TITLE=GNINA docking (test)
APP_VERSION=1.1
# Docker/Podman + NVIDIA GPU, one full CPU core (gnina's Monte Carlo search runs on the CPU)
PLAN_CLASS=docker_nvidia_cpu1
# validator: technical checks for every result, RMSD check for redocking jobs
VALIDATOR=script_validator --app gnina --init_script "gnina_validate.py files result_id"
ASSIMILATOR=sample_assimilator --app gnina
