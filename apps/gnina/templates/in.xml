<!-- inputs: receptor (PDB), ligand (SDF or PDB), box = crystal ligand defining the search box.
     boinc-app stages each test data file once and all jobs share it, so the file deleter must
     not remove it when one job is finished (no_delete). -->
<file_info>
    <number>0</number>
    <no_delete/>
</file_info>
<file_info>
    <number>1</number>
    <no_delete/>
</file_info>
<file_info>
    <number>2</number>
    <no_delete/>
</file_info>
<workunit>
    <file_ref>
        <file_number>0</file_number>
        <open_name>receptor</open_name>
        <copy_file/>
    </file_ref>
    <file_ref>
        <file_number>1</file_number>
        <open_name>ligand</open_name>
        <copy_file/>
    </file_ref>
    <file_ref>
        <file_number>2</file_number>
        <open_name>box</open_name>
        <copy_file/>
    </file_ref>
    <!-- rsc_fpops_est, rsc_fpops_bound, max_error_results and max_total_results come from
         jobs.py, which knows CPU vs. GPU (create_work: values in the template would override
         the command line). The bound is generous: the first job on a host also pulls the
         multi-GB app image, which counts as run time. -->
    <rsc_memory_bound>4000000000</rsc_memory_bound>
    <rsc_disk_bound>12000000000</rsc_disk_bound>
    <delay_bound>172800</delay_bound>
    <min_quorum>1</min_quorum>
    <target_nresults>1</target_nresults>
    <max_success_results>1</max_success_results>
</workunit>
