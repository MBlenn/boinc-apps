# BOINC app "gnina_cpu": the gnina test workload on the CPU only (no GPU reserved).
# Shares jobs.py, templates, server/ and testdata/ with apps/gnina (links).
APP_NAME=gnina_cpu
APP_TITLE=GNINA docking (CPU, test)
APP_VERSION=1.1
# Docker/Podman, one CPU core, no GPU. The name must not contain nvidia/cuda/amd/ati:
# the web site classifies plan classes by name ("Allow CPU-only tasks" preference).
PLAN_CLASS=docker_cpu1
# bare script name only, see the comment at the top of server/gnina_validate.py
VALIDATOR=script_validator --app gnina_cpu --init_script gnina_validate.py
ASSIMILATOR=sample_assimilator --app gnina_cpu
